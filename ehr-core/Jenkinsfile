pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('HIPAA Compliance Lint') {
    steps {
        script {
            def configFile = 'ehr-core/hipaa.properties'

            if (!fileExists(configFile)) {
                error('HIPAA configuration missing')
            }

            def config = readFile(configFile)

            if (!config.contains('AUDIT_LOGGING=ENABLED')) {
                error('Audit logging is disabled')
            }

            echo 'HIPAA Compliance Lint PASSED'
        }
    }
}

        stage('Docker Package') {
            steps {
                script {
                    sh 'docker build -t ehr-portal:2.0 .'
                }
            }
        }
    }
}
